// Prisma schema mirroring database/schema.sql + migrations
// (SQL files remain the source of truth; use `npm run prisma:pull`
// in backend/ to re-introspect after changing the SQL schema)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  departmentId   Int        @id @default(autoincrement()) @map("department_id")
  departmentName String     @unique @map("department_name") @db.VarChar(100)
  departmentCode String     @unique @map("department_code") @db.VarChar(10)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  employees      Employee[]
  positions      Position[]

  @@map("departments")
}

model Employee {
  employeeId       Int             @id @default(autoincrement()) @map("employee_id")
  firstName        String          @map("first_name") @db.VarChar(100)
  lastName         String          @map("last_name") @db.VarChar(100)
  email            String          @unique @db.VarChar(255)
  phone            String?         @db.VarChar(20)
  position         String          @db.VarChar(100)
  departmentId     Int             @map("department_id")
  hireDate         DateTime        @default(dbgenerated("CURRENT_DATE")) @map("hire_date") @db.Date
  salary           Decimal         @db.Decimal(12, 2)
  status           String          @default("active") @db.VarChar(20)
  annualLeaveQuota Int             @default(10) @map("annual_leave_quota")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  department       Department      @relation(fields: [departmentId], references: [departmentId], onDelete: Restrict)
  leaveRequests    LeaveRequest[]
  attendanceRecords AttendanceRecord[]
  bonuses          Bonus[]
  payrollRecords   PayrollRecord[]
  reviews          Review[]
  user             User?

  @@index([departmentId], map: "idx_employees_department")
  @@map("employees")
}

model LeaveRequest {
  leaveId   Int      @id @default(autoincrement()) @map("leave_id")
  employeeId Int     @map("employee_id")
  leaveType String   @map("leave_type") @db.VarChar(30)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  reason    String?
  status    String   @default("pending") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  employee  Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)

  @@index([employeeId], map: "idx_leave_requests_employee")
  @@map("leave_requests")
}

model User {
  userId       Int      @id @default(autoincrement()) @map("user_id")
  username     String   @unique @db.VarChar(50)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(150)
  role         String   @default("executive") @db.VarChar(20)
  employeeId   Int?     @map("employee_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  employee     Employee? @relation(fields: [employeeId], references: [employeeId], onDelete: SetNull)
  announcements Announcement[]

  @@map("users")
}

model AttendanceRecord {
  attendanceId Int       @id @default(autoincrement()) @map("attendance_id")
  employeeId   Int       @map("employee_id")
  workDate     DateTime  @map("work_date") @db.Date
  checkIn      DateTime  @map("check_in") @db.Time
  checkOut     DateTime? @map("check_out") @db.Time
  otHours      Decimal   @default(0) @map("ot_hours") @db.Decimal(5, 2)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  employee     Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)

  @@unique([employeeId, workDate])
  @@map("attendance")
}

model Bonus {
  bonusId    Int      @id @default(autoincrement()) @map("bonus_id")
  employeeId Int      @map("employee_id")
  bonusYear  Int      @map("bonus_year")
  amount     Decimal  @db.Decimal(12, 2)
  employee   Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)

  @@unique([employeeId, bonusYear])
  @@map("bonuses")
}

model PayrollRecord {
  payrollId      Int      @id @default(autoincrement()) @map("payroll_id")
  employeeId     Int      @map("employee_id")
  payPeriodYear  Int      @map("pay_period_year")
  payPeriodMonth Int      @map("pay_period_month")
  baseSalary     Decimal  @map("base_salary") @db.Decimal(12, 2)
  otHours        Decimal  @default(0) @map("ot_hours") @db.Decimal(7, 2)
  otPay          Decimal  @default(0) @map("ot_pay") @db.Decimal(12, 2)
  bonus          Decimal  @default(0) @db.Decimal(12, 2)
  sso            Decimal  @default(0) @db.Decimal(12, 2)
  tax            Decimal  @default(0) @db.Decimal(12, 2)
  netPay         Decimal  @default(0) @map("net_pay") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  employee       Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)

  @@unique([employeeId, payPeriodYear, payPeriodMonth])
  @@map("payroll_records")
}

model Announcement {
  announcementId Int      @id @default(autoincrement()) @map("announcement_id")
  title          String   @db.VarChar(200)
  body           String
  createdBy      Int?     @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  author         User?    @relation(fields: [createdBy], references: [userId], onDelete: SetNull)

  @@map("announcements")
}

model Review {
  reviewId     Int      @id @default(autoincrement()) @map("review_id")
  employeeId   Int      @map("employee_id")
  periodYear   Int      @map("period_year")
  reviewerName String   @map("reviewer_name") @db.VarChar(150)
  overallScore Decimal? @map("overall_score") @db.Decimal(4, 2)
  strengths    String?
  improvements String?
  status       String   @default("draft") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  employee     Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  goals        ReviewGoal[]

  @@unique([employeeId, periodYear])
  @@map("reviews")
}

model ReviewGoal {
  goalId   Int      @id @default(autoincrement()) @map("goal_id")
  reviewId Int      @map("review_id")
  title    String   @db.VarChar(255)
  weight   Int      @default(1)
  score    Decimal? @db.Decimal(4, 2)
  review   Review   @relation(fields: [reviewId], references: [reviewId], onDelete: Cascade)

  @@map("review_goals")
}

model Position {
  positionId   Int      @id @default(autoincrement()) @map("position_id")
  title        String   @db.VarChar(150)
  departmentId Int?     @map("department_id")
  description  String?
  headcount    Int      @default(1)
  status       String   @default("open") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  department   Department? @relation(fields: [departmentId], references: [departmentId], onDelete: SetNull)
  applicants   Applicant[]

  @@map("positions")
}

model Applicant {
  applicantId Int      @id @default(autoincrement()) @map("applicant_id")
  positionId  Int      @map("position_id")
  fullName    String   @map("full_name") @db.VarChar(150)
  email       String   @db.VarChar(255)
  phone       String?  @db.VarChar(20)
  status      String   @default("applied") @db.VarChar(20)
  notes       String?
  appliedAt   DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)
  position    Position @relation(fields: [positionId], references: [positionId], onDelete: Cascade)

  @@map("applicants")
}
