# Server
PORT=5000

# PostgreSQL (adjust to match your pgAdmin credentials)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hr_db
DB_USER=postgres
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string

# Prisma (same DB as above; URL-encode special chars in the password, e.g. @ -> %40)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/hr_db
